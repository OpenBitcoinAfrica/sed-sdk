{
  "name": "@openbitcoinafrica/sed-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the SeD (Service Discovery) protocol on Nostr",
  "type": "module",
  "main": "dist/sed/index.js",
  "types": "dist/sed/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sed/index.d.ts",
      "default": "./dist/sed/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenBitcoinAfrica/sed-sdk.git"
  },
  "keywords": ["nostr", "bitcoin", "lightning", "service-discovery", "sed", "africa"],
  "author": "OpenBitcoinAfrica",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/OpenBitcoinAfrica/sed-sdk/issues"
  },
  "homepage": "https://github.com/OpenBitcoinAfrica/sed-sdk#readme",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "nostr-tools": "^2.25.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "ws": "^8.22.1"
  }
}